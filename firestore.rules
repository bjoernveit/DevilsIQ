rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return isSignedIn() && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'displayName', 'role', 'createdAt', 'updatedAt', 'lastRoundStartedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 32 && data.username.matches('^[a-z0-9_.-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.role is string && data.role in ['player', 'coach']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastRoundStartedAt' in data) || data.lastRoundStartedAt is timestamp);
    }

    function isValidCoachDoc(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidDeletedUser(data, userId) {
      return data.keys().hasAll(['uid', 'deletedBy', 'deletedAt'])
        && data.keys().hasOnly(['uid', 'deletedBy', 'deletedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.deletedBy is string && data.deletedBy == request.auth.uid && data.deletedBy.size() >= 1 && data.deletedBy.size() <= 128
        && data.deletedAt is timestamp;
    }

    function isValidQuestion(data, questionId) {
      return data.keys().hasAll(['id', 'title', 'scenario', 'keyConcept', 'isPriorityFocus', 'tags', 'explanation', 'options', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'scenario', 'keyConcept', 'isPriorityFocus', 'tags', 'teamIds', 'explanation', 'options', 'diagram', 'imageUrl', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == questionId && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.scenario is string && data.scenario.size() >= 1 && data.scenario.size() <= 1000
        && data.keyConcept is string && data.keyConcept.size() <= 160
        && data.isPriorityFocus is bool
        && data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)
        && (!('teamIds' in data) || (data.teamIds is list && data.teamIds.size() <= 30 && (data.teamIds.size() == 0 || data.teamIds[0] is string)))
        && data.explanation is string && data.explanation.size() <= 1000
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 6 && data.options[0] is map
        && (!('diagram' in data) || data.diagram is map)
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000))
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttemptBase(data, attemptId) {
      return data.keys().hasAll(['id', 'playerId', 'timestamp', 'weekKey', 'totalScore', 'correctCount', 'totalQuestions', 'totalTimeSeconds', 'maxStreak', 'answers', 'createdAt'])
        && data.keys().hasOnly(['id', 'playerId', 'timestamp', 'weekKey', 'totalScore', 'correctCount', 'totalQuestions', 'totalTimeSeconds', 'maxStreak', 'answers', 'teamId', 'createdAt', 'passed'])
        && data.id is string && data.id == attemptId && data.id.size() <= 128
        && data.playerId is string && data.playerId.size() >= 1 && data.playerId.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.weekKey is string && data.weekKey.size() <= 16 && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 10000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 30
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 30
        && data.totalTimeSeconds is number && data.totalTimeSeconds >= 0 && data.totalTimeSeconds <= 3600
        && data.maxStreak is int && data.maxStreak >= 0 && data.maxStreak <= 30
        && data.answers is list && data.answers.size() <= 30
        && (!('teamId' in data) || (data.teamId is string && data.teamId.size() >= 1 && data.teamId.size() <= 128 && data.teamId.matches('^[a-zA-Z0-9_\\-]+$')))
        && (!('passed' in data) || data.passed is bool)
        && data.createdAt is timestamp;
    }

    function isValidAttempt(data, attemptId) {
      return isValidAttemptBase(data, attemptId)
        && data.playerId == request.auth.uid;
    }

    function isValidTeam(data, teamId) {
      return data.keys().hasAll(['id', 'name', 'playerIds', 'questionCount', 'timePerQuestionSeconds', 'prioritizeFocusQuestions', 'ensureDiverseTopics', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'playerIds', 'questionCount', 'timePerQuestionSeconds', 'prioritizeFocusQuestions', 'ensureDiverseTopics', 'selectedTags', 'isDefault', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == teamId && data.id.size() >= 1 && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.playerIds is list && data.playerIds.size() <= 100 && (data.playerIds.size() == 0 || data.playerIds[0] is string)
        && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 25
        && data.timePerQuestionSeconds is int && data.timePerQuestionSeconds >= 5 && data.timePerQuestionSeconds <= 120
        && data.prioritizeFocusQuestions is bool
        && data.ensureDiverseTopics is bool
        && (!('selectedTags' in data) || (data.selectedTags is list && data.selectedTags.size() <= 20 && (data.selectedTags.size() == 0 || data.selectedTags[0] is string)))
        && (!('isDefault' in data) || data.isDefault is bool)
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBootstrap(data) {
      return data.keys().hasAll(['coachUid', 'createdAt'])
        && data.keys().hasOnly(['coachUid', 'createdAt'])
        && data.coachUid is string && data.coachUid == request.auth.uid && data.coachUid.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidQuizConfig(data) {
      return data.keys().hasAll(['questionCount', 'timePerQuestionSeconds', 'prioritizeFocusQuestions', 'ensureDiverseTopics', 'updatedAt'])
        && data.keys().hasOnly(['questionCount', 'timePerQuestionSeconds', 'prioritizeFocusQuestions', 'ensureDiverseTopics', 'selectedTags', 'topicLabels', 'updatedAt'])
        && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 25
        && data.timePerQuestionSeconds is int && data.timePerQuestionSeconds >= 5 && data.timePerQuestionSeconds <= 120
        && data.prioritizeFocusQuestions is bool
        && data.ensureDiverseTopics is bool
        && (!('selectedTags' in data) || (data.selectedTags is list && data.selectedTags.size() <= 20))
        && (!('topicLabels' in data) || (data.topicLabels is list && data.topicLabels.size() <= 30 && (data.topicLabels.size() == 0 || data.topicLabels[0] is string)))
        && data.updatedAt is timestamp;
    }

    // Users collection (public team roster without PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isCoach() || existing().role in ['player', 'coach']
      );
      allow list: if isSignedIn() && existing().role in ['player', 'coach'];

      allow create: if isSignedIn() && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/deleted_users/$(userId))
        && (
          incoming().role == 'player'
          || (
            incoming().role == 'coach'
            && !exists(/databases/$(database)/documents/team_meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/team_meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/coaches/$(userId))
          )
        );

      allow update: if isSignedIn() && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isCoach() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt']))
          || (request.auth.uid == userId && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
          || (
            request.auth.uid == userId
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastRoundStartedAt', 'updatedAt'])
            && ('lastRoundStartedAt' in incoming())
            && incoming().lastRoundStartedAt == request.time
          )
        );

      allow delete: if isCoach() && isValidId(userId) && request.auth.uid != userId;
    }

    // Coaches role documents
    match /coaches/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isCoach());
      allow list: if isCoach();

      allow create: if isSignedIn() && isValidId(userId)
        && isValidCoachDoc(incoming(), userId)
        && incoming().createdAt == request.time
        && (
          isCoach()
          || (
            request.auth.uid == userId
            && !exists(/databases/$(database)/documents/team_meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/team_meta/bootstrap)
          )
        );

      allow update: if false;
      allow delete: if isCoach() && isValidId(userId) && request.auth.uid != userId;
    }

    // Playbook Questions
    match /questions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId);
      allow list: if isSignedIn() && existing().isPriorityFocus in [true, false];

      allow create: if isCoach() && isValidId(questionId)
        && isValidQuestion(incoming(), questionId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isCoach() && isValidId(questionId)
        && isValidQuestion(incoming(), questionId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'scenario', 'keyConcept', 'isPriorityFocus', 'tags', 'teamIds', 'explanation', 'options', 'diagram', 'imageUrl', 'updatedAt']);

      allow delete: if isCoach() && isValidId(questionId);
    }

    // Quiz Attempts
    match /attempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && (
        existing().playerId == request.auth.uid || isCoach() || existing().totalQuestions > 0
      );
      allow list: if isSignedIn() && existing().totalQuestions > 0;

      allow create: if isSignedIn() && isValidId(attemptId)
        && isValidAttempt(incoming(), attemptId)
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/deleted_users/$(request.auth.uid));

      allow update: if isCoach() && isValidId(attemptId)
        && isValidAttemptBase(incoming(), attemptId)
        && incoming().id == existing().id
        && incoming().playerId == existing().playerId
        && incoming().timestamp == existing().timestamp
        && incoming().weekKey == existing().weekKey
        && incoming().totalScore == existing().totalScore
        && incoming().correctCount == existing().correctCount
        && incoming().totalQuestions == existing().totalQuestions
        && incoming().totalTimeSeconds == existing().totalTimeSeconds
        && incoming().maxStreak == existing().maxStreak
        && incoming().answers == existing().answers
        && incoming().createdAt == existing().createdAt
        && (!('passed' in existing()) || incoming().passed == existing().passed)
        && incoming().diff(existing()).affectedKeys().hasOnly(['teamId'])
        && ('teamId' in incoming())
        && exists(/databases/$(database)/documents/teams/$(incoming().teamId));
      allow delete: if isCoach() && isValidId(attemptId);
    }

    // Team Meta (bootstrap lock & shared quiz config)
    match /team_meta/{metaId} {
      allow get: if isSignedIn() && isValidId(metaId) && (metaId == 'bootstrap' || metaId == 'quiz_config');
      allow list: if false;

      allow create: if isSignedIn() && isValidId(metaId) && (
        (
          metaId == 'bootstrap'
          && !exists(/databases/$(database)/documents/team_meta/bootstrap)
          && isValidBootstrap(incoming())
          && incoming().createdAt == request.time
        )
        || (
          metaId == 'quiz_config'
          && isCoach()
          && isValidQuizConfig(incoming())
          && incoming().updatedAt == request.time
        )
      );

      allow update: if isCoach() && isValidId(metaId) && metaId == 'quiz_config'
        && isValidQuizConfig(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['questionCount', 'timePerQuestionSeconds', 'prioritizeFocusQuestions', 'ensureDiverseTopics', 'selectedTags', 'topicLabels', 'updatedAt']);

      allow delete: if false;
    }

    // Deleted user tombstones (managed by coaches)
    match /deleted_users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isCoach());
      allow list: if false;

      allow create: if isCoach() && isValidId(userId)
        && request.auth.uid != userId
        && isValidDeletedUser(incoming(), userId)
        && incoming().deletedAt == request.time;

      allow update: if false;
      allow delete: if isCoach() && isValidId(userId) && request.auth.uid != userId;
    }

    // Shared Teams (managed by all coaches)
    match /teams/{teamId} {
      allow get: if isSignedIn() && isValidId(teamId);
      allow list: if isSignedIn() && existing().questionCount >= 1;

      allow create: if isCoach() && isValidId(teamId)
        && isValidTeam(incoming(), teamId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(teamId)
        && isValidTeam(incoming(), teamId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isCoach()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'playerIds', 'questionCount', 'timePerQuestionSeconds',
              'prioritizeFocusQuestions', 'ensureDiverseTopics', 'selectedTags', 'isDefault', 'updatedAt'
            ])
          )
          || (
            !exists(/databases/$(database)/documents/deleted_users/$(request.auth.uid))
            && ('isDefault' in existing())
            && existing().isDefault == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['playerIds', 'updatedAt'])
            && !(request.auth.uid in existing().playerIds)
            && (request.auth.uid in incoming().playerIds)
            && incoming().playerIds.hasAll(existing().playerIds)
            && incoming().playerIds.size() == existing().playerIds.size() + 1
          )
        );

      allow delete: if isCoach() && isValidId(teamId);
    }
  }
}
